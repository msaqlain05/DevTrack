# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=DevTrack
APP_VERSION=0.1.0
DEBUG=True

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./app/db/devtrack.db

# ── Security ─────────────────────────────────────────────────────────────────
# Generate strong keys with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

